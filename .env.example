# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Claude a utilizar para el análisis semántico
CLAUDE_MODEL=claude-sonnet-5

# Nivel de logging estructurado (pino): fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Entorno de ejecución
NODE_ENV=development

# --- Resiliencia ante la API de Claude (todas opcionales, con defaults razonables) ---

# Intentos totales (incluido el primero) ante timeouts, 429 o 5xx
ANTHROPIC_MAX_RETRIES=3

# Delay inicial del backoff exponencial entre reintentos (ms)
ANTHROPIC_RETRY_INITIAL_DELAY_MS=500

# Techo del backoff exponencial (ms)
ANTHROPIC_RETRY_MAX_DELAY_MS=8000

# Intervalo mínimo entre requests salientes a Claude (ms). 0 = sin espaciado
# artificial. Subilo si tu cuenta tiene un límite de RPM bajo y analizás
# repositorios grandes con muchos chunks.
ANTHROPIC_MIN_REQUEST_INTERVAL_MS=0
